generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon hands out a pooled URL for queries. DDL (`prisma db push`) needs the
  // direct, unpooled connection or it can hang behind the pooler.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CLIENT
  ARTIST
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique

  // Null for accounts that only ever signed in with Google — they never chose
  // a password. Every password path checks for it rather than assuming a hash
  // is there, and /account/edit lets such an account add one later.
  passwordHash String?

  // Google's `sub` claim, not the email. Google lets an account change its
  // address, and `sub` is the one identifier that stays put when it does, so
  // this is what a returning Google sign-in is matched on first.
  googleId String? @unique

  role      Role     @default(CLIENT)
  avatarUrl String?
  createdAt DateTime @default(now())

  // The public handle shown as @username on posts and stories. Optional in the
  // schema so adding it to a populated table needs no downtime, but every path
  // that creates a user assigns one, and existing rows were backfilled.
  username String? @unique
  bio      String?

  // Where Shana travels to. Saved once here, then offered as the default in the
  // booking wizard rather than retyped for every booking.
  phone   String?
  address String?
  city    String?

  bookings   Booking[]
  posts      Post[]
  stories    Story[]
  storyViews StoryView[]

  likes    Like[]
  saves    Save[]
  reviews  Review[]
  messages Message[]

  chatThread ChatThread?
}

/** Per-client inbox metadata for the artist.
 *
 * Messages stay keyed by userId rather than moving under this model: every
 * client has exactly one thread with Shana, and leaving the existing rows
 * untouched means adding the inbox needs no data migration. This row only
 * carries the flags the artist sets on a conversation. */
model ChatThread {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  pinned   Boolean @default(false)
  archived Boolean @default(false)
  // Mirrored from the newest message so the inbox can sort and show a
  // timestamp without loading every thread's messages.
  lastMessageAt DateTime @default(now())
  // When the artist last opened this thread. A client message newer than this
  // is what "waiting on you" means; null means she has never opened it.
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([pinned, lastMessageAt])
}

/** Credentials the artist manages from inside the app, encrypted at rest.
 *
 * `cipher` is AES-256-GCM under a key derived from AUTH_SECRET, so a dump of
 * this table on its own reveals nothing. `hint` is the last four characters
 * only — enough to tell two keys apart in the UI without ever sending the
 * secret back to a browser. */
model AppSecret {
  id        String   @id @default(cuid())
  name      String   @unique
  cipher    String
  hint      String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/** Studio facts the assistant answers from — prices, travel policy, timings.
 *
 * Edited by the artist in settings and injected into the model's system
 * prompt, so answers can change without a deploy. */
model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  body      String
  // Unpublishing beats deleting for a fact that is only wrong this season.
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model Look {
  id            String  @id
  order         Int     @default(0)
  title         String
  titleId       String
  category      String
  categoryId    String
  priceIdr      Int
  durationLabel String
  blurb         String
  blurbId       String
  includes      String
  includesId    String
  heroImage     String?

  bookings Booking[]
  posts    Post[]
}

model Booking {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lookId     String
  look       Look     @relation(fields: [lookId], references: [id])
  date       DateTime
  timeLabel  String
  venue      String
  extras     String
  totalIdr   Int
  depositIdr Int
  // Empty until the client reaches the payment step and picks transfer or QRIS.
  method String @default("")
  // requested -> accepted -> payment_review -> confirmed, or declined.
  // See src/lib/booking-status.ts, which owns the transitions and the labels.
  status String @default("requested")
  name   String
  phone  String
  email  String
  city   String
  notes  String?

  // Payment trail. proof is the Blob URL of the receipt the client uploads;
  // reference is whatever they typed (sender name, transaction id).
  paymentProof     String?
  paymentReference String?
  paymentSentAt    DateTime?
  // Why a request was declined, or why a receipt was sent back.
  adminNote  String?
  acceptedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())

  review Review?

  @@index([status])
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  lookId      String?
  look        Look?    @relation(fields: [lookId], references: [id])
  title       String
  description String
  place       String
  imageUrl    String?
  credit      Boolean  @default(true)
  extras      String
  createdAt   DateTime @default(now())

  likes Like[]
  saves Save[]
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caption   String
  imageUrl  String?
  createdAt DateTime @default(now())
  // Every read filters on this, so a story disappears on its own 24h after it
  // was posted even if nothing ever deletes the row.
  expiresAt DateTime

  views StoryView[]

  @@index([expiresAt])
}

model StoryView {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  storyId String
  // Cascade matters here: stories are deleted routinely, both by their owner and
  // by the expiry sweep, and a view row would otherwise block the delete.
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  traits    String
  note      String?
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  who       String
  text      String
  createdAt DateTime @default(now())
}

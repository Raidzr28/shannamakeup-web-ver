generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon hands out a pooled URL for queries. DDL (`prisma db push`) needs the
  // direct, unpooled connection or it can hang behind the pooler.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CLIENT
  ARTIST
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  // The public handle shown as @username on posts and stories. Optional in the
  // schema so adding it to a populated table needs no downtime, but every path
  // that creates a user assigns one, and existing rows were backfilled.
  username String? @unique
  bio      String?

  // Where Shana travels to. Saved once here, then offered as the default in the
  // booking wizard rather than retyped for every booking.
  phone   String?
  address String?
  city    String?

  bookings   Booking[]
  posts      Post[]
  stories    Story[]
  storyViews StoryView[]

  likes    Like[]
  saves    Save[]
  reviews  Review[]
  messages Message[]
}

model Look {
  id            String  @id
  order         Int     @default(0)
  title         String
  titleId       String
  category      String
  categoryId    String
  priceIdr      Int
  durationLabel String
  blurb         String
  blurbId       String
  includes      String
  includesId    String
  heroImage     String?

  bookings Booking[]
  posts    Post[]
}

model Booking {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lookId     String
  look       Look     @relation(fields: [lookId], references: [id])
  date       DateTime
  timeLabel  String
  venue      String
  extras     String
  totalIdr   Int
  depositIdr Int
  // Empty until the client reaches the payment step and picks transfer or QRIS.
  method String @default("")
  // requested -> accepted -> payment_review -> confirmed, or declined.
  // See src/lib/booking-status.ts, which owns the transitions and the labels.
  status String @default("requested")
  name   String
  phone  String
  email  String
  city   String
  notes  String?

  // Payment trail. proof is the Blob URL of the receipt the client uploads;
  // reference is whatever they typed (sender name, transaction id).
  paymentProof     String?
  paymentReference String?
  paymentSentAt    DateTime?
  // Why a request was declined, or why a receipt was sent back.
  adminNote  String?
  acceptedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())

  review Review?

  @@index([status])
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  lookId      String?
  look        Look?    @relation(fields: [lookId], references: [id])
  title       String
  description String
  place       String
  imageUrl    String?
  credit      Boolean  @default(true)
  extras      String
  createdAt   DateTime @default(now())

  likes Like[]
  saves Save[]
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caption   String
  imageUrl  String?
  createdAt DateTime @default(now())
  // Every read filters on this, so a story disappears on its own 24h after it
  // was posted even if nothing ever deletes the row.
  expiresAt DateTime

  views StoryView[]

  @@index([expiresAt])
}

model StoryView {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  storyId String
  // Cascade matters here: stories are deleted routinely, both by their owner and
  // by the expiry sweep, and a view row would otherwise block the delete.
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  traits    String
  note      String?
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  who       String
  text      String
  createdAt DateTime @default(now())
}
